@page "/projects/{ProjectId:int}/milestones/{MilestoneId:int}"
@using Workbench.ClientServices
@using Workbench.Components.Shared.Components
@using Workbench.Modules.Issues.Dtos
@using Workbench.Modules.Issues.Enums
@using Workbench.Modules.Issues.Services
@using Workbench.Modules.Milestones.Dtos
@using Workbench.Modules.Milestones.Services
@using Workbench.Modules.Projects.Services
@inject IMilestonesService MilestonesService
@inject IMilestoneIssuesService MilestoneIssuesService
@inject IProjectsService ProjectsService
@inject IProjectMembershipState ProjectMembership
@inject IAuthState AuthState
@inject ISnackbar Snackbar

<PageTitle>@(_milestone?.Name ?? "Milestone") - Workbench</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large">
    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" Class="d-flex justify-center ma-8"/>
    }
    else if (_milestone is null)
    {
        <MudPaper Class="pa-8 text-center">
            <MudText Typo="Typo.h6">Milestone not found</MudText>
        </MudPaper>
    }
    else
    {
        <PageHeader Title="@_milestone.Name" BackHref="@($"/projects/{ProjectId}?tab=milestones")">
            <RightContent>
                @if (_milestone.TotalItems > 0)
                {
                    var percent = (int)((double)_milestone.CompletedItems / _milestone.TotalItems * 100);
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">
                        @_milestone.CompletedItems/@_milestone.TotalItems completed (@percent%)
                    </MudChip>
                }
            </RightContent>
        </PageHeader>

        @if (!string.IsNullOrEmpty(_milestone.Description))
        {
            <MudText Typo="Typo.body1" Class="mb-2">@_milestone.Description</MudText>
        }

        @if (_milestone.DueDate.HasValue)
        {
            var isOverdue = _milestone.DueDate.Value < DateTime.UtcNow;
            <MudText Typo="Typo.body2" Color="@(isOverdue ? Color.Error : Color.Default)" Class="mb-4">
                <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" Class="mr-1"/>
                Due @_milestone.DueDate.Value.ToString("MMM dd, yyyy")
                @(isOverdue ? " (overdue)" : "")
            </MudText>
        }

        <MudDivider Class="my-4"/>

        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
            <MudText Typo="Typo.h6">Issues</MudText>
            <MudSpacer/>
            @if (ProjectMembership.IsLead)
            {
                <MudButton OnClick="OpenAddIssueDialog" Variant="Variant.Outlined"
                           Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small">
                    Add Issue
                </MudButton>
            }
        </MudStack>

        @if (_issues.Count == 0)
        {
            <EmptyState Title="No issues in this milestone"/>
        }
        else
        {
            <MudTable Items="_issues" Hover="true" Dense="true" Striped="true">
                <HeaderContent>
                    <MudTh>Title</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Tags</MudTh>
                    <MudTh>Score</MudTh>
                    @if (ProjectMembership.IsLead)
                    {
                        <MudTh></MudTh>
                    }
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Title">
                        <MudLink Href="@($"/projects/{ProjectId}/issues/{context.Id}")">
                            <span style="opacity: 0.5;">#@context.Id</span> @context.Title
                        </MudLink>
                    </MudTd>
                    <MudTd DataLabel="Status">
                        <StatusChip Status="context.Status"/>
                    </MudTd>
                    <MudTd DataLabel="Tags">
                        @foreach (var tag in context.Tags)
                        {
                            <TagChip Name="@tag.Name" Color="@tag.Color"/>
                        }
                    </MudTd>
                    <MudTd DataLabel="Score">
                        <MudIcon Icon="@Icons.Material.Filled.ThumbUp" Size="Size.Small" Class="mr-1"/>
                        @context.VoteScore
                    </MudTd>
                    @if (ProjectMembership.IsLead)
                    {
                        <MudTd>
                            <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small"
                                           Color="Color.Error"
                                           OnClick="() => RemoveIssueAsync(context.Id)"
                                           title="Remove from milestone"/>
                        </MudTd>
                    }
                </RowTemplate>
            </MudTable>
        }
    }
</MudContainer>

<IssuePickerDialog ProjectId="ProjectId"
                   ExcludeIssueIds="@(_issues.Select(i => i.Id).ToHashSet())"
                   Title="Add Issue to Milestone"
                   @bind-Visible="_addIssueDialogVisible"
                   IssueSelected="AddIssueAsync"/>

@code {
    [Parameter] public int ProjectId { get; set; }
    [Parameter] public int MilestoneId { get; set; }

    private MilestoneDto? _milestone;
    private List<IssueDto> _issues = new();
    private bool _loading = true;

    private bool _addIssueDialogVisible;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var project = await ProjectsService.GetById(ProjectId);
            await ProjectMembership.Load(ProjectId);
            ProjectMembership.SetOwner(AuthState.Username == project.OwnerUsername);

            _milestone = await MilestonesService.GetById(ProjectId, MilestoneId);
            _issues = await MilestoneIssuesService.GetAllIssues(ProjectId, MilestoneId);
        }
        catch
        {
        }

        _loading = false;
    }

    private async Task LoadMilestoneData()
    {
        try
        {
            _milestone = await MilestonesService.GetById(ProjectId, MilestoneId);
            _issues = await MilestoneIssuesService.GetAllIssues(ProjectId, MilestoneId);
        }
        catch
        {
        }
        StateHasChanged();
    }

    private void OpenAddIssueDialog()
    {
        _addIssueDialogVisible = true;
    }

    private async Task AddIssueAsync(int issueId)
    {
        try
        {
            await MilestoneIssuesService.AddIssue(ProjectId, MilestoneId, issueId);
            Snackbar.Add("Issue added to milestone", Severity.Success);
            await LoadMilestoneData();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task RemoveIssueAsync(int issueId)
    {
        try
        {
            await MilestoneIssuesService.RemoveIssue(ProjectId, MilestoneId, issueId);
            Snackbar.Add("Issue removed from milestone", Severity.Success);
            await LoadMilestoneData();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
