@page "/projects/{ProjectId:int}/issues/{Id:int}"
@using System.Text.RegularExpressions
@using Workbench.Components.Shared
@using Workbench.Components.Shared.Components
@using Workbench.Modules.Comments.Dtos
@using Workbench.Modules.Comments.Dtos.Requests
@using Workbench.Modules.Comments.Options
@using Workbench.Modules.Comments.Models
@using Workbench.Modules.Comments.Services
@using Workbench.Modules.Attachments.Services
@using Workbench.Modules.Issues.Models
@using Workbench.Modules.Issues.Dtos
@using Workbench.Modules.Issues.Dtos.Requests
@using Workbench.Modules.Issues.Enums
@using Workbench.Modules.Issues.Options
@using Workbench.Modules.Issues.Services
@using Workbench.Modules.Issues.Votes.Dtos.Requests
@using Workbench.Modules.Issues.Votes.Services
@using Workbench.Modules.Projects.Dtos
@using Workbench.Modules.Projects.Memberships.Dtos
@using Workbench.Modules.Projects.Memberships.Services
@using Workbench.Modules.Projects.Services
@using Workbench.Extensions
@rendermode InteractiveServer
@inject IIssuesService IssuesService
@inject IProjectsService ProjectsService
@inject IIssueStatusService IssueStatusService
@inject IVotesService VotesService
@inject ICommentsService CommentsService
@inject IIssueTagsService IssueTagsService
@inject IAttachmentsService<Issue> IssueAttachmentsService
@inject IAttachmentsService<Comment> CommentAttachmentsService
@inject IOptions<CommentAttachmentOptions> CommentAttachmentOptions
@inject IOptions<IssueAttachmentOptions> IssueAttachmentOptions
@inject IIssueAssignmentsService IssueAssignmentsService
@inject IProjectMembershipsService MembershipsService
@inject IAuthState AuthState
@inject IProjectMembershipState ProjectMembership
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject ILogger<IssueDetails> Logger

<PageTitle>Issue #@Id - Workbench</PageTitle>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" Class="d-flex justify-center ma-8"/>
}
else if (_issue is null)
{
    <MudContainer Class="text-center pa-8">
        <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Color="Color.Error"/>
        <MudText Typo="Typo.h6" Class="mt-2">Issue not found</MudText>
        <MudButton Href="@($"/projects/{ProjectId}?tab=issues")" Class="mt-4"
                   Variant="Variant.Outlined">Back to Project
        </MudButton>
    </MudContainer>
}
else
{
    <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-2">
        <PageHeader BackHref="@($"/projects/{ProjectId}?tab=issues")">
            <RightContent>
                <MudText Typo="Typo.h4">
                    <span style="opacity: 0.5; font-weight: 400;">#@_issue.Id</span>
                    @_issue.Title
                </MudText>
                <MudSpacer/>
                @if (_canEdit)
                {
                    <MudTooltip Text="Edit issue">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Inherit"
                                       OnClick="OpenEditDialog"/>
                    </MudTooltip>
                }
                @if (_canDelete)
                {
                    <MudTooltip Text="Delete issue">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                       OnClick="() => _deleteDialogVisible = true"/>
                    </MudTooltip>
                }
                <StatusChip Status="_issue.Status" Size="Size.Medium"/>
            </RightContent>
        </PageHeader>

        <MudPaper Class="pa-4 mb-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                <UserAvatar Username="@(_issue.AuthorUsername ?? "?")"/>
                <MudText Typo="Typo.body2">@_issue.AuthorUsername</MudText>
                <MudSpacer/>
                <MudText Typo="Typo.caption" Color="Color.Default">
                    @_issue.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                </MudText>
            </MudStack>

            @if (!string.IsNullOrEmpty(_issue.Description))
            {
                <MudText Typo="Typo.body1" Class="mt-2">@_issue.Description</MudText>
            }

            <MudStack Row="true" Class="mt-4" AlignItems="AlignItems.Center">
                @foreach (var tag in _issue.Tags)
                {
                    <TagChip Name="@tag.Name" Color="@tag.Color"/>
                }
            </MudStack>
        </MudPaper>

        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
            <MudText Typo="Typo.h6">Status</MudText>
            <MudSpacer/>
            @if (_canUpdateStatus)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudSelect T="Status" Value="_issue.Status" ValueChanged="SetStatus"
                               Dense="true" Style="width: 160px;">
                        <MudSelectItem Value="Status.Open">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small"
                                         Color="Color.Success"/>
                                Open
                            </MudStack>
                        </MudSelectItem>
                        <MudSelectItem Value="Status.InProgress">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Pending" Size="Size.Small"
                                         Color="Color.Warning"/>
                                In Progress
                            </MudStack>
                        </MudSelectItem>
                        <MudSelectItem Value="Status.Closed">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Cancel" Size="Size.Small"
                                         Color="Color.Default"/>
                                Closed
                            </MudStack>
                        </MudSelectItem>
                    </MudSelect>
                </MudStack>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Default">
                    @(_issue.Status switch
                    {
                        Status.Open => "Open",
                        Status.InProgress => "In Progress",
                        Status.Closed => "Closed",
                        _ => "Unknown"
                    })
                </MudText>
            }
        </MudStack>

        @if (!string.IsNullOrEmpty(_issue.AssignedToUsername) || ProjectMembership.IsMember)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
                <MudText Typo="Typo.h6">Assigned to</MudText>
                <MudSpacer/>
                @if (!string.IsNullOrEmpty(_issue.AssignedToUsername))
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <UserAvatar Username="@(_issue.AssignedToUsername ?? "?")"/>
                        <MudText Typo="Typo.body2">@_issue.AssignedToUsername</MudText>
                        @if ((_isAssignedToCurrentUser || ProjectMembership.IsLead) && _issue.Status != Status.Closed)
                        {
                            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="UnassignAsync" Disabled="_assigning"
                                       StartIcon="@Icons.Material.Filled.PersonRemove">
                                Unassign
                            </MudButton>
                        }
                    </MudStack>
                }
                else
                {
                    @if (ProjectMembership.IsLead && _issue.Status != Status.Closed)
                    {
                        <MemberSelect Members="_projectMembers" DefaultUsername="@AuthState.Username"
                                      Disabled="_assigning" OnAssignUser="AssignUserAsync"
                                      OnAssignSelf="AssignAsync"/>
                    }
                    else if (ProjectMembership.IsMember && _issue.Status != Status.Closed)
                    {
                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                   Color="Color.Primary"
                                   OnClick="AssignAsync" Disabled="_assigning"
                                   StartIcon="@Icons.Material.Filled.PersonAdd">
                            Self Assign
                        </MudButton>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Default">Unassigned</MudText>
                    }
                }
            </MudStack>
        }

        <MudDivider Class="mb-4"/>

        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
            <MudText Typo="Typo.h6">Attachments (@_attachments.Count)</MudText>
        </MudStack>

        @if (_attachments.Count > 0)
        {
            <MudGrid Class="mb-4">
                @foreach (var attachment in _attachments)
                {
                    <MudItem xs="6" sm="4" md="3">
                        <MudPaper Class="pa-1 relative" Style="cursor: pointer;"
                                  @onclick="() => OpenPreview(attachment.AttachmentId)">
                            <img src="@($"/api/attachments/{attachment.AttachmentId}")"
                                 alt="@attachment.OriginalFileName"
                                 style="width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 8px; display: block;"
                                 onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"/>
                            <div
                                style="display: none; width: 100%; aspect-ratio: 1; align-items: center; justify-content: center; flex-direction: column; background: var(--mud-palette-surface); border-radius: 8px; padding: 8px;">
                                <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile"
                                         Size="Size.Large" Color="Color.Default"/>
                                <MudText Typo="Typo.caption" Align="Align.Center" Class="mt-1"
                                         Style="word-break: break-all; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                                    @attachment.OriginalFileName
                                </MudText>
                            </div>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        }

        <MudDivider Class="mb-4"/>

        <MudText Typo="Typo.h6" Class="mb-2">Votes</MudText>
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
            <MudTooltip Text="Upvote">
                <MudIconButton Icon="@Icons.Material.Filled.ThumbUp"
                               Color="@(_currentVote == VoteValue.Upvote ? Color.Success : Color.Default)"
                               OnClick="() => VoteAsync(VoteValue.Upvote)"
                               Disabled="!AuthState.IsAuthenticated"/>
            </MudTooltip>
            <MudText Typo="Typo.h6" Class="mx-2">@_issue.VoteScore</MudText>
            <MudTooltip Text="Downvote">
                <MudIconButton Icon="@Icons.Material.Filled.ThumbDown"
                               Color="@(_currentVote == VoteValue.Downvote ? Color.Error : Color.Default)"
                               OnClick="() => VoteAsync(VoteValue.Downvote)"
                               Disabled="!AuthState.IsAuthenticated"/>
            </MudTooltip>
        </MudStack>

        <MudDivider Class="mb-4"/>

        <MudText Typo="Typo.h6" Class="mb-2">Activity</MudText>

        @if (_timeline.Count == 0)
        {
            <MudPaper Class="pa-4 mb-4 text-center">
                <MudText Typo="Typo.body2" Color="Color.Default">No activity yet</MudText>
            </MudPaper>
        }
        else
        {
            @foreach (var item in _timeline)
            {
                @if (item.Type == TimelineItemType.StatusChange && item.StatusChange is not null)
                {
                    var sc = item.StatusChange;
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2 ml-4"
                              Style="opacity: 0.7;">
                        <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Size="Size.Small"
                                 Color="Color.Default"/>
                        <MudText Typo="Typo.body2">
                            <strong>@sc.ChangedByUsername</strong> changed status from
                            <MudChip T="string" Size="Size.Small"
                                     Color="@(sc.FromStatus switch { Status.Open => Color.Success, Status.InProgress => Color.Warning, _ => Color.Default })"
                                     Variant="Variant.Outlined"
                                     Style="height: 18px; font-size: 0.7rem; pointer-events: none;">
                                @(sc.FromStatus switch { Status.Open => "Open", Status.InProgress => "In Progress", _ => "Closed" })
                            </MudChip>
                            to
                            <MudChip T="string" Size="Size.Small"
                                     Color="@(sc.ToStatus switch { Status.Open => Color.Success, Status.InProgress => Color.Warning, _ => Color.Default })"
                                     Variant="Variant.Outlined"
                                     Style="height: 18px; font-size: 0.7rem; pointer-events: none;">
                                @(sc.ToStatus switch { Status.Open => "Open", Status.InProgress => "In Progress", _ => "Closed" })
                            </MudChip>
                        </MudText>
                        <MudSpacer/>
                        <MudText Typo="Typo.caption" Color="Color.Default">
                            @sc.ChangedAt.ToString("MMM dd, yyyy HH:mm")
                        </MudText>
                    </MudStack>
                }
                else if (item.Type == TimelineItemType.Comment && item.Comment is not null)
                {
                    var comment = item.Comment;
                    <MudPaper Class="pa-3 mb-2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
                            <UserAvatar Username="@comment.AuthorUsername"/>
                            <MudText Typo="Typo.subtitle2">@comment.AuthorUsername</MudText>
                            <MudSpacer/>
                            <MudText Typo="Typo.caption" Color="Color.Default">
                                @comment.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                            </MudText>
                            @if (AuthState.Username == comment.AuthorUsername || ProjectMembership.IsMember)
                            {
                                <MudTooltip Text="Edit">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Size="Size.Small"
                                                   Color="Color.Inherit"
                                                   OnClick="() => OpenCommentEditDialog(comment)"/>
                                </MudTooltip>
                                <MudTooltip Text="Delete">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="() => DeleteComment(comment.Id)"/>
                                </MudTooltip>
                            }
                        </MudStack>
                        <div Class="ml-8" style="line-height: 1.6;">
                            @foreach (var seg in ParseComment(comment.Content))
                            {
                                @if (seg.IsReference && _referencedIssues.TryGetValue(seg.IssueId, out var refIssue))
                                {
                                    <MudLink Href="@($"/projects/{ProjectId}/issues/{seg.IssueId}")"
                                             Target="_blank"
                                             Style="vertical-align: middle; text-decoration: none;">
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="@(refIssue.Status switch { Status.Open => Color.Success, Status.InProgress => Color.Warning, _ => Color.Default })"
                                                 Variant="Variant.Outlined"
                                                 Style="height: 20px; font-size: 0.7rem; vertical-align: middle; pointer-events: none;">
                                            @(refIssue.Status switch { Status.Open => "Open", Status.InProgress => "In Progress", _ => "Closed" })
                                        </MudChip>
                                        <span
                                            style="font-size: 0.875rem; text-decoration: underline;">
                                            #@seg.IssueId
                                        </span>
                                        <span style="font-size: 0.875rem;">
                                            @(refIssue.Title.Length > 30 ? refIssue.Title[..30] + "..." : refIssue.Title)
                                        </span>
                                    </MudLink>
                                }
                                else if (seg.IsReference)
                                {
                                    <span
                                        style="font-size: 0.875rem;"><strong>@seg.Text</strong></span>
                                }
                                else
                                {
                                    <span style="font-size: 0.875rem;">@seg.Text</span>
                                }
                            }
                        </div>
                        @if (comment.Attachments.Count > 0)
                        {
                            var attachment = comment.Attachments[0];
                            <MudStack Row="true" Class="mt-2 ml-8">
                                <MudPaper Class="pa-1 relative"
                                          Style="cursor: pointer; width: 96px; height: 96px;"
                                          @onclick="() => OpenPreview(attachment.AttachmentId)">
                                    <img src="@($"/api/attachments/{attachment.AttachmentId}")"
                                         alt="@attachment.OriginalFileName"
                                         style="width: 100%; height: 100%; object-fit: cover; border-radius: 4px; display: block;"/>
                                </MudPaper>
                            </MudStack>
                        }
                    </MudPaper>
                }
            }
        }

        @if (AuthState.IsAuthenticated)
        {
            <MudPaper Class="pa-4 mt-4">
                <MudTextField @bind-Value="_newComment" Label="Add a comment"
                              Lines="3" MaxLength="2000"/>

                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-2 gap-2">
                    <InputFile id="newCommentFile"
                               key="@_newCommentFileKey"
                               accept="@string.Join(',', CommentAttachmentOptions.Value.AllowedExtensions)"
                               OnChange="OnNewCommentImageSelected"
                               hidden/>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Image"
                               HtmlTag="label" for="newCommentFile">
                        Attach Image
                    </MudButton>
                    @if (_newCommentImage is not null)
                    {
                        @if (_newCommentImagePreviewUrl is not null)
                        {
                            <img src="@_newCommentImagePreviewUrl"
                                 alt="@_newCommentImage.Name"
                                 style="width: 48px; height: 48px; object-fit: cover; border-radius: 4px; display: block;"/>
                        }

                        <MudText Typo="Typo.caption">@_newCommentImage.Name</MudText>
                        <MudTooltip Text="Remove image">
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                           Color="Color.Error" OnClick="ClearNewCommentImage"/>
                        </MudTooltip>
                    }
                </MudStack>

                <MudButton OnClick="AddCommentAsync" Color="Color.Primary" Variant="Variant.Filled"
                           Class="mt-2"
                           Disabled="string.IsNullOrWhiteSpace(_newComment) || _submittingComment">
                    @if (_submittingComment)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                    }
                    Post Comment
                </MudButton>
            </MudPaper>
        }
    </MudContainer>
}

<MudDialog @bind-Visible="_editDialogOpen" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Edit Issue</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_editTitle" Label="Title" Required="true" MaxLength="200"
                      Class="mb-4" FullWidth="true"/>
        <MudTextField @bind-Value="_editDescription" Label="Description" Lines="5" MaxLength="2000"
                      Class="mb-4" FullWidth="true"/>
        @if (ProjectMembership.IsMember)
        {
            <TagSelect ProjectId="ProjectId" Label="Tags"
                       SelectedValues="_editSelectedTags" SelectedValuesChanged="OnEditTagsChanged"/>
        }

        <MudDivider Class="my-4"/>

        <MudText Typo="Typo.subtitle1" Class="mb-2">Attachments</MudText>

        @if (_attachments.Count > 0)
        {
            var visibleAttachments = _attachments.Where(a => !_editDeletedAttachmentIds.Contains(a.AttachmentId)).ToList();
            @if (visibleAttachments.Count > 0)
            {
                <MudText Typo="Typo.body2" Class="mb-1" Color="Color.Default">Current
                    (@visibleAttachments.Count)
                </MudText>
                <MudStack Row="true" Wrap="Wrap.Wrap" Class="mb-2 gap-2">
                    @foreach (var attachment in visibleAttachments)
                    {
                        <MudPaper Class="pa-1 relative" Style="width: 80px; height: 80px;">
                            <img src="@($"/api/attachments/{attachment.AttachmentId}")"
                                 alt="@attachment.OriginalFileName"
                                 style="width: 100%; height: 100%; object-fit: cover; border-radius: 4px; display: block;"
                                 onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"/>
                            <div
                                style="display: none; width: 100%; height: 100%; align-items: center; justify-content: center; background: var(--mud-palette-surface); border-radius: 4px;">
                                <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile"
                                         Size="Size.Small"/>
                            </div>
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                           Color="Color.Error"
                                           Style="position: absolute; top: 2px; right: 2px;"
                                           OnClick="() => _editDeletedAttachmentIds.Add(attachment.AttachmentId)"/>
                        </MudPaper>
                    }
                </MudStack>
            }
        }

        <MudFileUpload @bind-Files="EditFiles" AppendMultipleFiles
                       Accept="@string.Join(',', IssueAttachmentOptions.Value.AllowedExtensions)">
            <CustomContent Context="fileUpload">
                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.AttachFile"
                           OnClick="@fileUpload.OpenFilePickerAsync">
                    Add Files
                </MudButton>
            </CustomContent>
        </MudFileUpload>

        @if (_editFiles is { Count: > 0 })
        {
            <MudText Typo="Typo.body2" Class="mt-2 mb-1" Color="Color.Default">New
                (@_editFiles.Count)
            </MudText>
            <MudGrid Class="mb-2">
                @foreach (var file in _editFiles)
                {
                    <MudItem xs="4" sm="3">
                        <MudPaper Class="pa-1 relative" Style="width: 80px; height: 80px;">
                            @if (_editPreviewUrls.TryGetValue(file, out var dataUrl) && dataUrl is not null)
                            {
                                <img src="@dataUrl"
                                     alt="@file.Name"
                                     style="width: 100%; height: 100%; object-fit: cover; border-radius: 4px; display: block;"/>
                            }
                            else
                            {
                                <div
                                    style="width: 100%; height: 100%; align-items: center; justify-content: center; flex-direction: column; background: var(--mud-palette-surface); border-radius: 4px; display: flex;">
                                    <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile"
                                             Size="Size.Small"/>
                                </div>
                            }
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _editDialogOpen = false">Cancel</MudButton>
        <MudButton OnClick="SaveEditAsync" Color="Color.Primary" Disabled="_savingEdit">
            @if (_savingEdit)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
            }
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_deleteDialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Delete Issue</MudText>
    </TitleContent>
    <DialogContent>
        <MudText>Are you sure you want to delete <strong>@_issue?.Title</strong>? This action cannot
            be undone.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _deleteDialogVisible = false">Cancel</MudButton>
        <MudButton OnClick="DeleteIssueAsync" Color="Color.Error" Disabled="_deleting">
            @if (_deleting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
            }
            Delete
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public int ProjectId { get; set; }
    [Parameter] public int Id { get; set; }

    private IssueDto? _issue;
    private ProjectDto? _project;
    private List<AttachmentDto> _attachments = new();
    private List<CommentDto> _comments = new();
    private List<StatusChangeDto> _statusChanges = new();
    private List<TimelineItem> _timeline = new();
    private VoteValue? _currentVote;
    private bool _loading = true;
    private string _newComment = "";
    private bool _submittingComment;
    private IBrowserFile? _newCommentImage;
    private string? _newCommentImagePreviewUrl;
    private int _newCommentFileKey;
    private bool _canUpdateStatus;
    private bool _canEdit;
    private bool _canDelete;
    private bool _isAssignedToCurrentUser;
    private bool _assigning;
    private List<ProjectMembershipDto> _projectMembers = new();

    private bool _editDialogOpen;
    private string _editTitle = "";
    private string? _editDescription;
    private bool _savingEdit;
    private HashSet<string> _editSelectedTags = new();
    private IReadOnlyList<IBrowserFile>? _editFiles;
    private readonly Dictionary<IBrowserFile, string?> _editPreviewUrls = new();
    private readonly HashSet<Guid> _editDeletedAttachmentIds = new();
    private readonly DialogOptions _dialogOptions = AppDialogOptions.Medium;

    private bool _deleteDialogVisible;
    private bool _deleting;

    private readonly Dictionary<int, IssueDto> _referencedIssues = new();
    private static readonly Regex _issueRefRegex = new(@"#(\d+)", RegexOptions.Compiled);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _issue = await IssuesService.GetById(ProjectId, Id);
            _attachments = _issue.Attachments;
            _comments = await CommentsService.GetAll(Id);
            _project = await ProjectsService.GetById(ProjectId);
            await ProjectMembership.Load(ProjectId);
            ProjectMembership.SetOwner(AuthState.Username == _project.OwnerUsername);

            if (ProjectMembership.IsLead)
            {
                _projectMembers = await MembershipsService.GetProjectMemberships(ProjectId);
            }

            try
            {
                _statusChanges = await IssueStatusService.GetStatusHistory(Id);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to load issue {IssueId}", Id);
                Snackbar.Add($"Failed to load issue: {ex.Message}", Severity.Error);
            }

            try
            {
                var voteDto = await VotesService.GetUserVote(Id);
                _currentVote = voteDto.Vote;
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to load vote for issue {IssueId}", Id);
            }

            _canUpdateStatus = AuthState.IsAuthenticated && ProjectMembership.IsMember;
            _canEdit = AuthState.IsAuthenticated && ProjectMembership.IsMember;
            _canDelete = AuthState.IsAuthenticated
                         && (AuthState.Username == _issue?.AuthorUsername || ProjectMembership.IsLead);
            _isAssignedToCurrentUser = AuthState.IsAuthenticated
                                       && _issue?.AssignedToUsername == AuthState.Username;

            await LoadReferencedIssues();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load issue {IssueId}", Id);
        }

        BuildTimeline();
        _loading = false;
    }

    private void OpenEditDialog()
    {
        if (_issue is null) return;
        _editTitle = _issue.Title;
        _editDescription = _issue.Description;
        _editSelectedTags = new HashSet<string>(_issue.Tags.Select(t => t.Name));
        _editFiles = null;
        _editPreviewUrls.Clear();
        _editDeletedAttachmentIds.Clear();
        _editDialogOpen = true;
    }

    private void OnEditTagsChanged(IReadOnlyCollection<string> values)
    {
        _editSelectedTags = new HashSet<string>(values);
    }

    private IReadOnlyList<IBrowserFile>? EditFiles
    {
        get => _editFiles;
        set
        {
            _editFiles = value;
            _ = LoadEditPreviews();
        }
    }

    private static readonly string[] ImageTypes = { "image/jpeg", "image/png", "image/gif", "image/webp" };

    private async Task LoadEditPreviews()
    {
        if (_editFiles is null) return;

        var current = new HashSet<IBrowserFile>(_editFiles);

        foreach (var file in current)
        {
            if (_editPreviewUrls.ContainsKey(file)) continue;

            if (file.ContentType is not null && ImageTypes.Contains(file.ContentType))
            {
                try
                {
                    using var stream = file.OpenReadStream(IssueAttachmentOptions.Value.MaxSizeBytes);
                    using var ms = new MemoryStream();
                    await stream.CopyToAsync(ms);
                    _editPreviewUrls[file] = $"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
                }
                catch
                {
                    _editPreviewUrls[file] = null;
                }
            }
            else
            {
                _editPreviewUrls[file] = null;
            }
        }

        foreach (var key in _editPreviewUrls.Keys.ToList())
        {
            if (!current.Contains(key))
                _editPreviewUrls.Remove(key);
        }

        StateHasChanged();
    }

    private async Task SaveEditAsync()
    {
        if (string.IsNullOrWhiteSpace(_editTitle) || _issue is null) return;

        _savingEdit = true;
        try
        {
            var updated = await IssuesService.Update(ProjectId, Id, new UpdateIssueRequest
            {
                Title = _editTitle,
                Description = _editDescription
            });
            _issue = updated;

            if (ProjectMembership.IsMember)
            {
                await IssueTagsService.UpdateTags(Id, _editSelectedTags.ToList());
            }

            foreach (var attachmentId in _editDeletedAttachmentIds)
            {
                try
                {
                    await IssueAttachmentsService.Delete(attachmentId);
                }
                catch
                {
                }
            }

            if (_editFiles is { Count: > 0 })
            {
                foreach (var file in _editFiles)
                {
                    try
                    {
                        var maxSize = IssueAttachmentOptions.Value.MaxSizeBytes;
                        var formFile = await file.ToFormFile(maxSize);
                        await IssueAttachmentsService.Add(Id, formFile);
                    }
                    catch
                    {
                    }
                }
            }

            var refreshed = await IssuesService.GetById(ProjectId, Id);
            _issue = refreshed;
            _attachments = _issue.Attachments;

            _editDialogOpen = false;
            Snackbar.Add("Issue updated", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _savingEdit = false;
        }
    }

