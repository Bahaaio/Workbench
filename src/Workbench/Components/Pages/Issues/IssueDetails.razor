    private async Task AddCommentAsync()
    {
        if (string.IsNullOrWhiteSpace(_newComment)) return;

        _submittingComment = true;
        try
        {
            var comment = await CommentsService.Create(Id, new CreateCommentRequest(_newComment));

            if (_newCommentImage is not null)
            {
                try
                {
                    var maxSize = CommentAttachmentOptions.Value.MaxSizeBytes;
                    var formFile = await _newCommentImage.ToFormFile(maxSize);
                    var attachment = await CommentAttachmentsService.Add(comment.Id, formFile);
                    comment = comment with { Attachments = [attachment] };
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"Comment posted but image upload failed: {ex.Message}", Severity.Warning);
                }
            }

            _comments.Add(comment);
            _newComment = "";
            ClearNewCommentImage();
            BuildTimeline();
            await LoadReferencedIssues();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _submittingComment = false;
        }
    }

    private async Task OnNewCommentImageSelected(InputFileChangeEventArgs e)
    {
        _newCommentImagePreviewUrl = null;

        var file = e.File;

        var extension = Path.GetExtension(file.Name).ToLowerInvariant();
        var allowedExtensions = CommentAttachmentOptions.Value.AllowedExtensions;
        if (!allowedExtensions.Contains(extension))
        {
            Snackbar.Add($"Only {string.Join(", ", allowedExtensions)} files are allowed", Severity.Error);
            return;
        }

        var maxSizeBytes = CommentAttachmentOptions.Value.MaxSizeBytes;
        if (file.Size > maxSizeBytes)
        {
            Snackbar.Add($"Image must be {maxSizeBytes / 1024 / 1024} MB or smaller", Severity.Error);
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(maxSizeBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            _newCommentImagePreviewUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
            _newCommentImage = file;
        }
        catch
        {
            Snackbar.Add("Failed to read the selected file", Severity.Error);
        }
    }

    private void ClearNewCommentImage()
    {
        _newCommentImage = null;
        _newCommentImagePreviewUrl = null;
        _newCommentFileKey++;
    }

    private async Task OpenCommentEditDialog(CommentDto comment)
    {
        var parameters = new DialogParameters<CommentEditDialog>
        {
            { x => x.Comment, comment }
        };
        var dialog = await DialogService.ShowAsync<CommentEditDialog>("Edit Comment", parameters);
        var result = await dialog.Result;

        if (result is null || result.Canceled) return;

        if (result.Data is CommentDto updated)
            ReplaceCommentInState(comment.Id, updated);
    }

    private void ReplaceCommentInState(int commentId, CommentDto updated)
    {
        var index = _comments.FindIndex(c => c.Id == commentId);
        if (index >= 0)
            _comments[index] = updated;

        for (var i = 0; i < _timeline.Count; i++)
        {
            if (_timeline[i].Type == TimelineItemType.Comment && _timeline[i].Comment?.Id == commentId)
                _timeline[i] = _timeline[i] with { Comment = updated };
        }
    }

    private async Task DeleteComment(int commentId)
    {
        try
        {
            await CommentsService.Delete(commentId);
            _comments.RemoveAll(c => c.Id == commentId);
            BuildTimeline();
            Snackbar.Add("Comment deleted", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task LoadReferencedIssues()
    {
        var ids = new HashSet<int>();
        foreach (var comment in _comments)
        {
            foreach (Match m in _issueRefRegex.Matches(comment.Content))
            {
                if (int.TryParse(m.Groups[1].Value, out var tid) && tid != Id)
                    ids.Add(tid);
            }
        }

        foreach (var tid in ids)
        {
            if (!_referencedIssues.ContainsKey(tid))
            {
                try
                {
                    var t = await IssuesService.GetById(ProjectId, tid);
                    _referencedIssues[tid] = t;
                }
                catch
                {
                }
            }
        }
    }

    private List<CommentSegment> ParseComment(string content)
    {
        var segments = new List<CommentSegment>();
        var lastEnd = 0;
        foreach (Match m in _issueRefRegex.Matches(content))
        {
            if (m.Index > lastEnd)
                segments.Add(new CommentSegment(false, content[lastEnd..m.Index], 0));

            if (int.TryParse(m.Groups[1].Value, out var tid))
                segments.Add(new CommentSegment(true, m.Value, tid));

            lastEnd = m.Index + m.Length;
        }

        if (lastEnd < content.Length)
            segments.Add(new CommentSegment(false, content[lastEnd..], 0));

        return segments;
    }

    private record CommentSegment(bool IsReference, string Text, int IssueId);

    private void BuildTimeline()
    {
        _timeline = new List<TimelineItem>();
        foreach (var c in _comments)
            _timeline.Add(new TimelineItem(c.CreatedAt, TimelineItemType.Comment, c));
        foreach (var s in _statusChanges)
            _timeline.Add(new TimelineItem(s.ChangedAt, TimelineItemType.StatusChange, StatusChange: s));
        _timeline.Sort((a, b) => a.Timestamp.CompareTo(b.Timestamp));
    }

    private record TimelineItem(DateTime Timestamp, TimelineItemType Type, CommentDto? Comment = null, StatusChangeDto? StatusChange = null);

    private enum TimelineItemType
    {
        Comment,
        StatusChange
    }

