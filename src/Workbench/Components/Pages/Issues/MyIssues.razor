@page "/issues/mine"
@using Workbench.Components.Shared.Components
@using Workbench.Modules.Issues.Dtos
@using Workbench.Modules.Issues.Dtos.Requests
@using Workbench.Modules.Issues.Enums
@using Workbench.Modules.Issues.Services
@rendermode InteractiveServer
@inject IIssuesService IssuesService
@inject NavigationManager Navigation

<PageTitle>My Issues - Workbench</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large">
    <MudText Typo="Typo.h4" Class="mb-4">My Issues</MudText>

    <IssueFilterBar @bind-SearchText="_searchText" @bind-SelectedStatus="_selectedStatus"
                    @bind-SortBy="_sortBy" OnFilterChanged="LoadIssues"/>

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" Class="d-flex justify-center ma-8"/>
    }
    else if (_issues.Count == 0)
    {
        <EmptyState Title="No issues found"/>
    }
    else
    {
        <IssueTable Issues="_issues" ShowProjectColumn="true"/>
    }
</MudContainer>

@code {
    private List<IssueDto> _issues = new();
    private bool _loading = true;
    private string _searchText = "";
    private string _selectedStatus = "all";
    private string _sortBy = "Latest";

    protected override async Task OnInitializedAsync()
    {
        await LoadIssues();
    }

    private async Task LoadIssues()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            var query = new IssueQuery(
                _selectedStatus != "all" ? Enum.Parse<Status>(_selectedStatus) : null,
                null,
                null,
                string.IsNullOrWhiteSpace(_searchText) ? null : _searchText,
                Enum.Parse<IssueSort>(_sortBy)
            );

            _issues = await IssuesService.GetCurrentUserIssues(query);
        }
        catch
        {
        }

        _loading = false;
    }

}
