@using Workbench.Modules.Comments.Dtos
@using Workbench.Modules.Comments.Dtos.Requests
@using Workbench.Modules.Comments.Options
@using Workbench.Modules.Comments.Services
@using Workbench.Modules.Attachments.Services
@using Workbench.Modules.Comments.Models
@using Workbench.Extensions
@inject ICommentsService CommentsService
@inject IAttachmentsService<Comment> AttachmentsService
@inject IOptions<CommentAttachmentOptions> CommentAttachmentOptions
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Edit Comment</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_content" Label="Comment" Lines="3" MaxLength="2000"
                      Class="mb-2"/>

        @if (_selectedFile is null)
        {
            @if (Comment.Attachments.Count > 0)
            {
                <img src="@($"/api/attachments/{Comment.Attachments[0].AttachmentId}")"
                     alt="Current image"
                     style="max-width: 100%; max-height: 40vh; border-radius: 8px; display: block; margin: 0 auto;"
                     onerror="this.style.display='none'"/>
            }
        }
        else if (_previewUrl is not null)
        {
            <img src="@_previewUrl"
                 alt="@_selectedFile.Name"
                 style="max-width: 100%; max-height: 40vh; border-radius: 8px; display: block; margin: 0 auto;"/>
        }

        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-3">
            <InputFile id="editCommentFile"
                       key="@_editFileKey"
                       accept="@string.Join(',', CommentAttachmentOptions.Value.AllowedExtensions)"
                       OnChange="OnFileSelected"
                       hidden/>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Image"
                       Size="Size.Small"
                       HtmlTag="label" for="editCommentFile">
                @(Comment.Attachments.Count > 0 ? "Replace Image" : "Attach Image")
            </MudButton>
            @if (_selectedFile is not null)
            {
                <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                           OnClick="ClearSelection">
                    Remove Selection
                </MudButton>
            }
            else if (_hasImage && !_removeImage)
            {
                <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Delete"
                           OnClick='() => _removeImage = true'>
                    Remove Image
                </MudButton>
            }
        </MudStack>

        <MudText Typo="Typo.caption" Color="Color.Default" Class="mt-2 text-center">
            Optional image (@string.Join(", ", CommentAttachmentOptions.Value.AllowedExtensions)),
            max @(CommentAttachmentOptions.Value.MaxSizeBytes / 1024 / 1024) MB.
        </MudText>
    </DialogContent>
    <DialogActions>
        @if (_removeImage)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                Current image will be removed
            </MudChip>
        }
        <MudSpacer/>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton OnClick="SaveAsync" Color="Color.Primary" Disabled="_saving || !_canSave">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
            }
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>The comment being edited.</summary>
    [Parameter]
    public CommentDto Comment { get; set; } = null!;

    private string _content = "";
    private bool _saving;
    private IBrowserFile? _selectedFile;
    private string? _previewUrl;
    private bool _removeImage;
    private int _editFileKey;

    private bool _hasImage => Comment.Attachments.Count > 0;
    private bool _contentChanged => !string.IsNullOrWhiteSpace(_content) && _content != Comment.Content;
    private bool _imageChanged => _selectedFile is not null || _removeImage;
    private bool _canSave => _contentChanged || _imageChanged;

    protected override void OnInitialized()
    {
        _content = Comment.Content;
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _previewUrl = null;
        _removeImage = false;

        var file = e.File;

        var extension = Path.GetExtension(file.Name).ToLowerInvariant();
        var allowedExtensions = CommentAttachmentOptions.Value.AllowedExtensions;
        if (!allowedExtensions.Contains(extension))
        {
            Snackbar.Add($"Only {string.Join(", ", allowedExtensions)} files are allowed", Severity.Error);
            return;
        }

        var maxSizeBytes = CommentAttachmentOptions.Value.MaxSizeBytes;
        if (file.Size > maxSizeBytes)
        {
            Snackbar.Add($"Image must be {maxSizeBytes / 1024 / 1024} MB or smaller", Severity.Error);
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(maxSizeBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            _previewUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
            _selectedFile = file;
        }
        catch
        {
            Snackbar.Add("Failed to read the selected file", Severity.Error);
        }
    }

    private void ClearSelection()
    {
        _selectedFile = null;
        _previewUrl = null;
        _editFileKey++;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (!_canSave) return;

        _saving = true;
        try
        {
            var updated = Comment;

            if (_contentChanged)
            {
                updated = await CommentsService.Update(Comment.Id,
                    new UpdateCommentRequest(_content.Trim()));
            }

            if (_removeImage && _hasImage)
            {
                await AttachmentsService.Delete(Comment.Attachments[0].AttachmentId);
                updated = updated with { Attachments = [] };
                Snackbar.Add("Image removed", Severity.Success);
            }
            else if (_selectedFile is not null)
            {
                if (_hasImage)
                    await AttachmentsService.Delete(Comment.Attachments[0].AttachmentId);

                var maxSize = CommentAttachmentOptions.Value.MaxSizeBytes;
                var formFile = await _selectedFile.ToFormFile(maxSize);
                var added = await AttachmentsService.Add(Comment.Id, formFile);
                updated = updated with { Attachments = [added] };
                Snackbar.Add(_hasImage ? "Image replaced" : "Image attached", Severity.Success);
            }

            if (_contentChanged)
                Snackbar.Add("Comment updated", Severity.Success);

            MudDialog.Close(updated);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

}
