<MudPaper Class="pa-8 text-center">
    <MudIcon Icon="@Icon" Size="Size.Large" Color="Color.Default"/>
    <MudText Typo="Typo.h6" Class="mt-2">@Title</MudText>
    @if (!string.IsNullOrEmpty(Description))
    {
        <MudText Typo="Typo.body2" Color="Color.Default" Class="mt-1">@Description</MudText>
    }
</MudPaper>

@code {
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.Inbox;
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
}
