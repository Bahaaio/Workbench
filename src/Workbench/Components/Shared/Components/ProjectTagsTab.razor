@rendermode InteractiveServer
@inject ITagsService TagsService
@inject ISnackbar Snackbar
@using Workbench.Components.Shared
@using Workbench.Components.Shared.Components
@using Workbench.Modules.Tags.Dtos
@using Workbench.Modules.Tags.Dtos.Requests
@using Workbench.Modules.Tags.Services
@using Color = Workbench.Common.Enums.Color

<MudStack Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
        <MudSpacer/>
        <MudButton OnClick="() => _createDialogVisible = true" Variant="Variant.Filled"
                   Color="MudBlazor.Color.Primary" StartIcon="@Icons.Material.Filled.Add">
            New Tag
        </MudButton>
    </MudStack>

    @if (_tagsLoading)
    {
        <MudProgressCircular Indeterminate="true" Class="d-flex justify-center ma-8"/>
    }
    else if (_tags.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Filled.LabelOff" Title="No tags yet"/>
    }
    else
    {
        <MudDataGrid Items="_tags" Hover="true" Dense="true" Striped="true">
            <Columns>
                <TemplateColumn Title="Name">
                    <CellTemplate>
                        <TagChip Name="@context.Item.Name" Color="@context.Item.Color"/>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Description" Title="Description"/>
                <TemplateColumn Title="Actions" Sortable="false" Filterable="false">
                    <CellTemplate>
                        <div @onclick:stopPropagation>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                           OnClick="() => StartEditTag(context.Item)"/>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                           Color="MudBlazor.Color.Error"
                                           OnClick="() => ConfirmDeleteTag(context.Item)"/>
                        </div>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    }
</MudStack>

@* Create Tag Dialog *@
<MudDialog @bind-Visible="_createDialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">New Tag</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_createName" Label="Name" Required="true" MaxLength="50"
                      Class="mb-4" FullWidth="true"/>
        <MudTextField @bind-Value="_createDescription" Label="Description (optional)"
                      MaxLength="2000"
                      Class="mb-4" FullWidth="true"/>
        <ColorPicker @bind-Value="_createColor" Label="Color"/>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _createDialogVisible = false">Cancel</MudButton>
        <MudButton Color="MudBlazor.Color.Primary" OnClick="CreateTagAsync"
                   Disabled="_savingTag || string.IsNullOrWhiteSpace(_createName)">Create
        </MudButton>
    </DialogActions>
</MudDialog>

@* Edit Tag Dialog *@
<MudDialog @bind-Visible="_editDialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Edit Tag: @_editingTag?.Name</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_editDescription" Label="Description" MaxLength="2000"
                      Class="mb-4" FullWidth="true"/>
        <ColorPicker @bind-Value="_editColor" Label="Color"/>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _editDialogVisible = false">Cancel</MudButton>
        <MudButton Color="MudBlazor.Color.Primary" OnClick="SaveTagAsync" Disabled="_savingTag">
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

@* Delete Tag Dialog *@
<MudDialog @bind-Visible="_deleteDialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Delete Tag</MudText>
    </TitleContent>
    <DialogContent>
        <MudText>Are you sure you want to delete <strong>@_deletingTag?.Name</strong>?</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _deleteDialogVisible = false">Cancel</MudButton>
        <MudButton OnClick="DeleteTagAsync" Color="MudBlazor.Color.Error"
                   Disabled="_deletingTagLoading">Delete
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public int ProjectId { get; set; }

    private List<TagDto> _tags = new();
    private bool _tagsLoading;
    private bool _savingTag;
    private bool _deletingTagLoading;
    private readonly DialogOptions _dialogOptions = AppDialogOptions.Small;

    // Create
    private bool _createDialogVisible;
    private string _createName = "";
    private string? _createDescription;
    private Color _createColor = Color.Blue;

    // Edit
    private bool _editDialogVisible;
    private TagDto? _editingTag;
    private string? _editDescription;
    private Color _editColor = Color.Blue;

    // Delete
    private bool _deleteDialogVisible;
    private TagDto? _deletingTag;

    protected override async Task OnInitializedAsync()
    {
        await LoadTags();
    }

    private async Task LoadTags()
    {
        _tagsLoading = true;
        try
        {
            _tags = await TagsService.GetAll(ProjectId);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }

        _tagsLoading = false;
        StateHasChanged();
    }

    private async Task CreateTagAsync()
    {
        if (string.IsNullOrWhiteSpace(_createName)) return;

        _savingTag = true;
        try
        {
            await TagsService.Create(ProjectId, new CreateTagRequest(_createName.Trim(), _createDescription, _createColor));
            _createDialogVisible = false;
            _createName = "";
            _createDescription = "";
            _createColor = Color.Blue;
            Snackbar.Add("Tag created", Severity.Success);
            await LoadTags();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _savingTag = false;
        }
    }

    private void StartEditTag(TagDto tag)
    {
        _editingTag = tag;
        _editDescription = tag.Description;
        _editColor = tag.Color;
        _editDialogVisible = true;
    }

    private async Task SaveTagAsync()
    {
        if (_editingTag is null) return;

        _savingTag = true;
        try
        {
            await TagsService.Update(ProjectId, _editingTag.Name,
                new UpdateTagRequest(_editDescription, _editColor));
            _editDialogVisible = false;
            Snackbar.Add("Tag updated", Severity.Success);
            await LoadTags();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _savingTag = false;
        }
    }

    private void ConfirmDeleteTag(TagDto tag)
    {
        _deletingTag = tag;
        _deleteDialogVisible = true;
    }

    private async Task DeleteTagAsync()
    {
        if (_deletingTag is null) return;

        _deletingTagLoading = true;
        try
        {
            await TagsService.Delete(ProjectId, _deletingTag.Name);
            _deleteDialogVisible = false;
            Snackbar.Add("Tag deleted", Severity.Success);
            await LoadTags();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _deletingTagLoading = false;
        }
    }

}
