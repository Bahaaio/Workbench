@using Workbench.ClientServices
@using Workbench.Components.Shared
@using Workbench.Components.Shared.Components
@using Workbench.Modules.Projects.Dtos
@using Workbench.Modules.Projects.Enums
@using Workbench.Modules.Projects.Memberships.Dtos
@using Workbench.Modules.Projects.Memberships.Services
@inject IProjectMembershipState ProjectMembership
@inject IProjectMembershipsService MembershipsService
@inject IAuthState AuthState
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<MudStack Class="pa-4">
    @if (!string.IsNullOrEmpty(Project.Description))
    {
        <MudText Typo="Typo.body1" Class="mb-4">@Project.Description</MudText>
    }

    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
        <UserAvatar Username="@Project.OwnerUsername"/>
        <MudText Typo="Typo.body2">
            Owned by <strong>@Project.OwnerUsername</strong>
        </MudText>
        <MudSpacer/>
        <MudText Typo="Typo.caption" Color="Color.Default">
            Created @Project.CreatedAt.ToString("MMM dd, yyyy")
        </MudText>
    </MudStack>

    <MudDivider Class="my-4"/>

    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
        <MudText Typo="Typo.h6">Members</MudText>
        <MudSpacer/>
        @if (IsLead)
        {
            <MudTooltip Text="Invite member">
                <MudIconButton Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Small"
                               OnClick="() => _inviteDialogVisible = true"/>
            </MudTooltip>
        }
        @if (ProjectMembership.IsMember && !ProjectMembership.IsOwner)
        {
            <MudTooltip Text="Leave project">
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Logout"
                           OnClick="() => _leaveDialogVisible = true">
                    Leave
                </MudButton>
            </MudTooltip>
        }
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
            @Members.Count
        </MudChip>
    </MudStack>

    @if (Members.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Default" Class="ml-2">No members yet.</MudText>
    }
    else
    {
        <MudList T="ProjectMembershipDto" Dense="true">
            @foreach (var member in Members)
            {
                var isCurrentUser = member.Username == AuthState.Username;
                var isOwner = member.Username == Project.OwnerUsername;
                <MudListItem Value="member">
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <UserAvatar Username="@member.Username"/>
                        <MudText Typo="Typo.body2">@member.Username</MudText>
                        <MudSpacer/>
                        @if (IsLead && !isCurrentUser && !isOwner)
                        {
                            if (member.Role == ProjectMemberRole.Member)
                            {
                                <MudTooltip Text="Promote to Lead">
                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small"
                                                   OnClick="() => ShowPromoteDialog(member)"/>
                                </MudTooltip>
                            }
                            else
                            {
                                <MudTooltip Text="Demote to Member">
                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small"
                                                   OnClick="() => ShowDemoteDialog(member)"/>
                                </MudTooltip>
                            }
                            @if (member.Role != ProjectMemberRole.Lead)
                            {
                                <MudTooltip Text="Remove member">
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="() => ShowRemoveDialog(member)"/>
                                </MudTooltip>
                            }
                        }
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(member.Role == ProjectMemberRole.Lead ? Color.Primary : Color.Default)"
                                 Variant="Variant.Outlined">
                            @member.Role
                        </MudChip>
                    </MudStack>
                </MudListItem>
            }
        </MudList>
    }
</MudStack>

<InviteDialog ProjectId="Project.Id" @bind-Visible="_inviteDialogVisible"/>

<MudDialog @bind-Visible="_promoteDialogVisible" Options="AppDialogOptions.Small">
    <TitleContent>
        <MudText Typo="Typo.h6">Promote to Lead</MudText>
    </TitleContent>
    <DialogContent>
        <MudText>Promote <strong>@_targetMember?.Username</strong> to Lead?</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _promoteDialogVisible = false">Cancel</MudButton>
        <MudButton OnClick="ConfirmPromote" Color="Color.Primary">Promote</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_demoteDialogVisible" Options="AppDialogOptions.Small">
    <TitleContent>
        <MudText Typo="Typo.h6">Demote to Member</MudText>
    </TitleContent>
    <DialogContent>
        <MudText>Demote <strong>@_targetMember?.Username</strong> to Member?</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _demoteDialogVisible = false">Cancel</MudButton>
        <MudButton OnClick="ConfirmDemote" Color="Color.Primary">Demote</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_removeDialogVisible" Options="AppDialogOptions.Small">
    <TitleContent>
        <MudText Typo="Typo.h6">Remove Member</MudText>
    </TitleContent>
    <DialogContent>
        <MudText>Remove <strong>@_targetMember?.Username</strong> from this project? They will be unassigned from all open issues.</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _removeDialogVisible = false">Cancel</MudButton>
        <MudButton OnClick="ConfirmRemove" Color="Color.Error">Remove</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_leaveDialogVisible" Options="AppDialogOptions.Small">
    <TitleContent>
        <MudText Typo="Typo.h6">Leave Project</MudText>
    </TitleContent>
    <DialogContent>
        <MudText>Are you sure you want to leave <strong>@Project.Name</strong>? You will be unassigned from all open issues.</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _leaveDialogVisible = false">Cancel</MudButton>
        <MudButton OnClick="ConfirmLeave" Color="Color.Error">Leave</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public ProjectDto Project { get; set; } = default!;
    [Parameter] public List<ProjectMembershipDto> Members { get; set; } = new();
    [Parameter] public bool IsLead { get; set; }

    private bool _inviteDialogVisible;
    private ProjectMembershipDto? _targetMember;

    private bool _promoteDialogVisible;
    private bool _demoteDialogVisible;
    private bool _removeDialogVisible;
    private bool _leaveDialogVisible;

    protected override void OnInitialized()
    {
        AuthState.Check();
    }

    private void ShowPromoteDialog(ProjectMembershipDto member)
    {
        _targetMember = member;
        _promoteDialogVisible = true;
    }

    private void ShowDemoteDialog(ProjectMembershipDto member)
    {
        _targetMember = member;
        _demoteDialogVisible = true;
    }

    private void ShowRemoveDialog(ProjectMembershipDto member)
    {
        _targetMember = member;
        _removeDialogVisible = true;
    }

    private async Task ConfirmPromote()
    {
        _promoteDialogVisible = false;
        await UpdateRole(_targetMember!, ProjectMemberRole.Lead);
    }

    private async Task ConfirmDemote()
    {
        _demoteDialogVisible = false;
        await UpdateRole(_targetMember!, ProjectMemberRole.Member);
    }

    private async Task ConfirmRemove()
    {
        _removeDialogVisible = false;
        await RemoveMember(_targetMember!);
    }

    private async Task ConfirmLeave()
    {
        _leaveDialogVisible = false;
        try
        {
            await MembershipsService.LeaveProject(Project.Id);
            Snackbar.Add("You left the project", Severity.Success);
            Navigation.NavigateTo("/projects");
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task UpdateRole(ProjectMembershipDto member, ProjectMemberRole newRole)
    {
        try
        {
            await MembershipsService.UpdateRole(Project.Id, member.Username, newRole);
            var index = Members.FindIndex(m => m.Username == member.Username);
            if (index >= 0)
                Members[index] = new ProjectMembershipDto(member.UserId, member.Username, newRole);
            Snackbar.Add($"{member.Username} is now {newRole}", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task RemoveMember(ProjectMembershipDto member)
    {
        try
        {
            await MembershipsService.RemoveMember(Project.Id, member.Username);
            Members.RemoveAll(m => m.Username == member.Username);
            Snackbar.Add($"{member.Username} removed from project", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
