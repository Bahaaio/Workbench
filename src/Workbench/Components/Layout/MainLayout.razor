@inherits LayoutComponentBase
@using Workbench.Components.Shared.Components
@inject NavigationManager Navigation
@inject IAuthState AuthState

@if (!_initialized)
{
    <MudThemeProvider @bind-IsDarkMode="_isDarkMode"/>
    <MudPopoverProvider/>
    <MudDialogProvider/>
    <MudSnackbarProvider/>
    <MudLayout>
        <MudMainContent>
            <MudContainer Class="d-flex justify-center align-center" Style="min-height: 80vh;">
                <MudProgressCircular Size="Size.Large" Indeterminate="true"/>
            </MudContainer>
        </MudMainContent>
    </MudLayout>
}
else if (!AuthState.IsAuthenticated)
{
    Navigation.NavigateTo("/login", true);
}
else
{
    <MudThemeProvider @bind-IsDarkMode="_isDarkMode"/>
    <MudPopoverProvider/>
    <MudDialogProvider/>
    <MudSnackbarProvider/>
    <MudLayout>
        <MudAppBar Elevation="1">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"
                           Edge="Edge.Start" OnClick="ToggleDrawer"/>
            <MudText Typo="Typo.h6" Class="cursor-pointer"
                     @onclick='() => Navigation.NavigateTo("/projects")'>
                Workbench
            </MudText>
            <MudSpacer/>

            <MudText Typo="Typo.body2" Class="mr-2">@AuthState.Username</MudText>
            @if (!string.IsNullOrEmpty(AuthState.Username))
            {
                <UserAvatar Username="@AuthState.Username"/>
            }

            <MudTooltip Text="Logout">
                <form method="post" action="/api/auth/logout">
                    <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit"
                                   ButtonType="ButtonType.Submit"/>
                </form>
            </MudTooltip>
        </MudAppBar>

        <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Docked" Elevation="2">
            <MudNavMenu>
                <MudNavLink Href="/projects" Icon="@Icons.Material.Filled.FolderOpen"
                            Match="NavLinkMatch.Prefix">
                    All Projects
                </MudNavLink>
                <MudNavLink Href="/projects/mine" Icon="@Icons.Material.Filled.Folder"
                            Match="NavLinkMatch.Prefix">
                    My Projects
                </MudNavLink>
                <MudNavLink Href="/issues/mine" Icon="@Icons.Material.Filled.Person"
                            Match="NavLinkMatch.Prefix">
                    My Issues
                </MudNavLink>
            </MudNavMenu>
        </MudDrawer>

        <MudMainContent Class="px-4" Style="padding-top: calc(var(--mud-appbar-height) + 16px);">
            @Body
        </MudMainContent>
    </MudLayout>
}

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode;
    private bool _initialized;

    protected override void OnInitialized()
    {
        AuthState.Check();
        _initialized = true;
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

}
